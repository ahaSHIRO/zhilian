{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhilian:question-batch:v1",
  "title": "知练题目批次格式 v1",
  "description": "电脑端 AI 出题、经复审与验收定稿后经 Syncthing 同步的题目批次文件。一个文件一个批次。规格文档见 docs/schema/batch-spec-v1.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "batchId", "batchOrder", "createdAt", "subject", "questions"],
  "properties": {
    "formatVersion": {
      "const": 1,
      "description": "格式版本，本 Schema 对应常量 1。App 拒绝非 1 值并说明原因。"
    },
    "batchId": {
      "$ref": "#/$defs/uuid",
      "description": "批次唯一 ID，全生命周期永不复用。"
    },
    "batchOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999,
      "description": "批次顺序号，决定顺序练习中的追加次序；不得与任何已导入批次重复。"
    },
    "createdAt": {
      "type": "string",
      "format": "date",
      "description": "批次创建日期，ISO 8601（YYYY-MM-DD）。"
    },
    "subject": {
      "enum": ["kotlin", "java", "arkts", "interview"],
      "description": "科目代码，小写。扩科目需修改本 Schema 与 App 侧适配。interview 为面试科目（题源分基础面试题/常见面试题，见 batch-spec-v1.md）。"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/question" },
      "description": "本批次新增题目，数组顺序即批次文件内顺序（顺序练习排序依据之一）。"
    },
    "retiredQuestionIds": {
      "type": "array",
      "default": [],
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" },
      "description": "本批次宣布停用的既有题目 ID。停用不可逆，历史保留。不得包含本批次 questions 中的 ID（应用级校验）。"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "小写 UUID v4。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^\\S(.*\\S)?$",
      "description": "分类/标签名：1-32 字符，禁止首尾空白；Unicode NFC 规范化后以精确字符串为身份（应用级校验）。"
    },
    "mdText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "not": { "pattern": "!\\[" },
      "description": "Markdown 纯文本内容：禁止图片语法（首版不含图片）。"
    },
    "optionId": {
      "type": "string",
      "pattern": "^[A-F]$",
      "description": "选项标识，单个大写字母 A-F；options 数组内不得重复（应用级校验）。"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "text"],
        "properties": {
          "optionId": { "$ref": "#/$defs/optionId" },
          "text": { "$ref": "#/$defs/mdText", "description": "选项文本，Markdown。" }
        }
      },
      "description": "选择题选项，数组顺序即展示顺序。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "accessedDate"],
      "anyOf": [
        { "required": ["url"] },
        { "required": ["note"] }
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "来源标题；Obsidian 素材可填笔记标题。"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "网络来源链接；Obsidian 素材可省略改用 note。"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "补充来源说明，如 Obsidian 笔记路径。"
        },
        "accessedDate": {
          "type": "string",
          "format": "date",
          "description": "素材访问日期，ISO 8601（YYYY-MM-DD）。"
        }
      },
      "description": "来源引用：标题 + 访问日期必填，url 与 note 至少提供其一。"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "type", "category", "tags", "stem", "explanation", "source"],
      "properties": {
        "questionId": {
          "$ref": "#/$defs/uuid",
          "description": "题目唯一 ID，全局永不复用；修订视为新题新 ID。"
        },
        "type": {
          "enum": ["single_choice", "multiple_choice", "true_false", "fill_in_blank"],
          "description": "题型：单选 / 多选 / 判断 / 单空填空。"
        },
        "category": {
          "$ref": "#/$defs/name",
          "description": "单层分类名，科目内以名字为身份。"
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" },
          "description": "标签，可为空数组；建议全小写。"
        },
        "stem": {
          "$ref": "#/$defs/mdText",
          "description": "题干，Markdown。"
        },
        "explanation": {
          "$ref": "#/$defs/mdText",
          "description": "解析，Markdown，必填。"
        },
        "source": { "$ref": "#/$defs/source" },
        "options": { "$ref": "#/$defs/options" },
        "answer": {
          "description": "标准答案：单选为单个选项 ID 字符串；多选为选项 ID 数组（≥2，互异）；判断为布尔。"
        },
        "acceptableAnswers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(.*\\S)?$"
          },
          "description": "填空题可接受答案，互异；匹配规则：用户答案去除首尾空白后区分大小写精确比对。"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "single_choice" } } },
          "then": {
            "required": ["options", "answer"],
            "not": { "required": ["acceptableAnswers"] },
            "properties": {
              "options": { "$ref": "#/$defs/options" },
              "answer": { "$ref": "#/$defs/optionId" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "multiple_choice" } } },
          "then": {
            "required": ["options", "answer"],
            "not": { "required": ["acceptableAnswers"] },
            "properties": {
              "options": { "$ref": "#/$defs/options" },
              "answer": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/optionId" }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "true_false" } } },
          "then": {
            "required": ["answer"],
            "not": { "anyOf": [{ "required": ["options"] }, { "required": ["acceptableAnswers"] }] },
            "properties": {
              "answer": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "fill_in_blank" } } },
          "then": {
            "required": ["acceptableAnswers"],
            "not": { "anyOf": [{ "required": ["options"] }, { "required": ["answer"] }] },
            "properties": {
              "acceptableAnswers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^\\S(.*\\S)?$"
                }
              }
            }
          }
        }
      ],
      "description": "题目。注意 answer 引用的 optionId 必须存在于 options 中（应用级校验，Schema 无法表达）。"
    }
  }
}
